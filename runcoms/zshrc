#
# Executes commands at the start of an interactive session.
#
# Authors:
#   Sorin Ionescu <sorin.ionescu@gmail.com>
#

# Source Prezto.
if [[ -s "${ZDOTDIR:-$HOME}/.zprezto/init.zsh" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprezto/init.zsh"
fi

# Customize to your needs...

export EDITOR=vim
export VISUAL=$EDITOR

# privacy
export DISABLE_ERROR_REPORTING=1
export DISABLE_TELEMETRY=1
export DO_NOT_TRACK=1
export DNT=1

# Claude
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
export CLAUDE_CODE_TMUX_TRUECOLOR=1

# brew (macOS: Apple silicon or Intel; Linux: Homebrew on Linux)
for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew "$HOME/.linuxbrew/bin/brew"; do
  if [ -x "$brew_bin" ]; then
    echo "[Init] brew"
    export BREW_INSTALLED=true
    eval "$("$brew_bin" shellenv)"
    break
  fi
done
unset brew_bin

# Support certificate signing
if [ -f "/etc/pki/tls/certs/ca-bundle.crt" ]; then
  export CURL_CA_BUNDLE="/etc/pki/tls/certs/ca-bundle.crt"
  alias brew="CURL_CA_BUNDLE='' brew" # brew might not work otherwise
fi

# user tools (uv tools, pipx, mise's own installer on Linux)
export PATH="$HOME/.local/bin:$PATH"

# mise: Node, Python, Java etc. per user, never the system ones
# (replaces nvm, rbenv, pyenv, jabba and jenv)
if (( $+commands[mise] )); then
  echo "[Init] mise"
  eval "$(mise activate zsh)"
fi

# rustup
if [ -s "$HOME/.cargo/env" ]; then
  echo "[Init] rustup"
  source "$HOME/.cargo/env"
fi

# postgres
if [ -d "/usr/local/opt/postgresql@9.6" ]; then
  export PATH="/usr/local/opt/postgresql@9.6/bin:$PATH"
fi

# brew keg-only packages (only those that are installed)
if [ -n "$HOMEBREW_PREFIX" ]; then
  for pkg (openssl openblas lapack); do
    PREFIX="$HOMEBREW_PREFIX/opt/$pkg"
    [ -d "$PREFIX" ] || continue
    export LDFLAGS="-L${PREFIX}/lib $LDFLAGS"
    export CPPFLAGS="-I${PREFIX}/include $CPPFLAGS"
    export PKG_CONFIG_PATH="${PREFIX}/lib/pkgconfig:$PKG_CONFIG_PATH"
  done
  unset pkg PREFIX
fi

# git (Oh My Zsh-style aliases)
alias g='git'
alias ga='git add'
alias gaa='git add --all'
alias gapa='git add --patch'
alias gau='git add --update'
alias gav='git add --verbose'

alias gb='git branch'
alias gba='git branch -a'
alias gbd='git branch -d'
alias gbD='git branch -D'
alias gbnm='git branch --no-merged'
alias gbr='git branch --remote'

alias gco='git checkout'
alias gcor='git checkout --recurse-submodules'
alias gcb='git checkout -b'
alias gsw='git switch'
alias gswc='git switch -c'

alias gc='git commit -v'
alias 'gc!'='git commit -v --amend'
alias 'gcn!'='git commit -v --no-edit --amend'
alias gca='git commit -v -a'
alias 'gca!'='git commit -v -a --amend'
alias gcam='git commit -a -m'
alias gcsm='git commit -s -m'
alias gcmsg='git commit -m'
alias gcs='git commit -S'

alias gcl='git clone --recurse-submodules'
alias gclean='git clean -id'

alias gd='git diff'
alias gdca='git diff --cached'
alias gds='git diff --staged'
alias gdw='git diff --word-diff'

alias gf='git fetch'
alias gfa='git fetch --all --tags --prune'
alias gfo='git fetch origin'

alias gl='git pull'
alias glg='git log --stat'
alias glgp='git log --stat -p'
alias glo='git log --oneline --decorate'
alias glog='git log --oneline --decorate --graph'
alias gloga='git log --oneline --decorate --graph --all'

alias gm='git merge'
alias gma='git merge --abort'

alias gp='git push'
alias gpd='git push --dry-run'
alias gpf='git push --force-with-lease'
alias 'gpf!'='git push --force'
alias gpu='git push upstream'
alias gpv='git push -v'

alias gr='git remote'
alias gra='git remote add'
alias grv='git remote -v'

alias grb='git rebase'
alias grba='git rebase --abort'
alias grbc='git rebase --continue'
alias grbi='git rebase -i'
alias grbo='git rebase --onto'
alias grbs='git rebase --skip'

alias gst='git status'
alias gss='git status -s'
alias gsb='git status -sb'

alias gsta='git stash push'
alias gstaa='git stash apply'
alias gstc='git stash clear'
alias gstd='git stash drop'
alias gstl='git stash list'
alias gstp='git stash pop'
alias gsts='git stash show --text'

# gradle
alias gw="./gradlew"
alias gww="./gradleww"

# docker
alias dc="docker compose"

# gcloud
GCLOUD_SDK_DIR="$HOME/.gcloud/google-cloud-sdk"
if [ -d "$GCLOUD_SDK_DIR" ]; then
  source "$GCLOUD_SDK_DIR"/completion.zsh.inc
  source "$GCLOUD_SDK_DIR"/path.zsh.inc
fi

# local custom overrides
if [ -f "$HOME/.zprofile_local_only" ]; then
  echo "[Init] local zprofile"
  source "$HOME/.zprofile_local_only"
fi

# zsh
unsetopt share_history

compresspdf() {
    # Usage: compresspdf [input file] [output file] [screen*|ebook|printer|prepress]
    gs -sDEVICE=pdfwrite -dNOPAUSE -dQUIET -dBATCH -dPDFSETTINGS=/${3:-"screen"} -dCompatibilityLevel=1.4 -sOutputFile="$2" "$1"
}

# Tailscale CLI (mac)
TAILSCALE_BINARY="/Applications/Tailscale.app/Contents/MacOS/Tailscale"
if [ -f "$TAILSCALE_BINARY" ]; then alias tailscale="$TAILSCALE_BINARY"; fi

# Docker Desktop CLI completions (only if Docker Desktop is installed)
# The following lines have been added by Docker Desktop to enable Docker CLI completions.
if [ -d "$HOME/.docker/completions" ]; then
  fpath=("$HOME/.docker/completions" $fpath)
  autoload -Uz compinit
  (( ${+_comps[docker]} )) || compinit
fi
# End of Docker CLI completions
